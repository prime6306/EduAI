# ── Flask ─────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
FLASK_DEBUG=false
FLASK_PORT=5000

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=eduai

# ── Groq LLM ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini LLM (Interview Prep's second "recruiter" persona) ──
# Optional — Interview Prep still works with only GROQ_API_KEY set; both
# interviewer personas just run on Groq until a Gemini key is added.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_PATH=./chromadb_data

# ── External APIs (optional — features degrade gracefully) ───
YOUTUBE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=EduAI

# ── Model paths ───────────────────────────────────────────────
# Anti-spoof model is a pretrained .pkl you provide yourself — drop it at this path.
ANTISPOOF_MODEL_PATH=./models/antispoof_fullmodels.pkl
FACE_ENCODINGS_PATH=./models/ENcodedFile.p

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# ── Mail (optional — Weekly Digest emails degrade gracefully without it) ──
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=EduAI Digest <noreply@eduai.local>

# ── Weekly Digest scheduler ────────────────────────────────────
DIGEST_SCHEDULER_ENABLED=true
